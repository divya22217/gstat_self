  function get_filtred_date(search_type){
	var user_type = $("#search_menuaccess_codeall").val();
	var selected_case_type = $("#search_c_case").val();
	var data_to_send = '';
	if(search_type == '1'){
		var data1 = $("#start_date").val();
		var data2 = $("#to_date").val();
		
		data_to_send = data1+"||"+data2;
	}
	if(search_type == '2'){
		var search_filing_no = $("#search_filing_no").val();
		data_to_send = search_filing_no;
	}
	$.ajax({
		type: "POST",
		url: "ajax/custom_search.php",
		data: {search_type : search_type, user_type:user_type, selected_case_type:selected_case_type, data_to_send:data_to_send},
		beforeSend: function() {
			
		},
		success: function (data) {
			if(selected_case_type == 1){
			$("#case_one_scrutiny_clerk").html(data);
			}
			if(selected_case_type == 3){
			$("#ia_ma_data").html(data);
			}
		},
		error: function (textStatus, errorThrown) {
		   alert("error");
		}

	});
  }
  
function get_form(search_type,dynamic_param){
	search_type = '1';
	$.ajax({
		type: "POST",
		url: "../ajax/connected_cases.php",
		data: {type:"get_form",search_type:search_type},
		success: function (data) {
			if(data != ''){
				var obj = JSON.parse(data);
				if(obj.type == '1'){
					$("#search_form"+dynamic_param+" #case_no_wise_search_form"+dynamic_param+" #case_type"+dynamic_param).html('');
					$("#search_form"+dynamic_param+" #case_no_wise_search_form"+dynamic_param+" #bench"+dynamic_param).html('');
					$.each( obj.bench, function( key, value ) {
						var o = new Option(value.city_name, value.city_id);
						$(o).html(value.city_name);
						$("#search_form"+dynamic_param+" #case_no_wise_search_form"+dynamic_param+" #bench"+dynamic_param).append(o);
					});
					$.each( obj.case_types, function( key, value ) {
						var o = new Option(value.case_type_desc, value.id);
						$(o).html(value.case_type_desc);
						$("#search_form"+dynamic_param+" #case_no_wise_search_form"+dynamic_param+" #case_type"+dynamic_param).append(o);
					});
					$("#search_form"+dynamic_param+" #case_no_wise_search_form"+dynamic_param+" #case_no"+dynamic_param).val('');
					$("#search_form"+dynamic_param+" #case_no_wise_search_form"+dynamic_param+" #case_year"+dynamic_param).val('');
					$("#search_form"+dynamic_param+" #case_no_wise_search_form"+dynamic_param).css('display','inherit');
					$("#search_form"+dynamic_param+" #filing_no_wise_search_form"+dynamic_param).css('display','none');
					
				}else{
					$("#search_form"+dynamic_param+" #filing_no_wise_search_form"+dynamic_param+" #bench"+dynamic_param).html('');
					$.each( obj.bench, function( key, value ) {
						var o = new Option(value.city_name, value.city_id);
						$(o).html(value.city_name);
						$("#search_form"+dynamic_param+" #filing_no_wise_search_form"+dynamic_param+" #bench"+dynamic_param).append(o);
						$("#search_form"+dynamic_param+" #filing_no_wise_search_form"+dynamic_param+" #filing_no_"+dynamic_param).val('');
						$("#search_form"+dynamic_param+" #filing_no_wise_search_form"+dynamic_param).css('display','inherit');
						$("#search_form"+dynamic_param+" #case_no_wise_search_form"+dynamic_param).css('display','none');
					});
				}
			}else{
				alert("search type error");
			}
			if(dynamic_param == ''){
				$("#view_connected_cases,#cause_title").removeClass('show');
				$("#view_connected_cases,#cause_title").addClass('hide');
			}else{
				$("#search_button_second").css('display',"inherit");
			}
		},
		error: function (textStatus, errorThrown) {
		   alert("error");
		}

	});
}

function get_cases(dynamic_param,type){
	$("#show_bulk").html('');
	if(dynamic_param == ''){
	$("#view_connected_cases #table_data #search_data_here").html('');
	}
	//var search_type = $("#search_type").val();
	var search_type = '1';
	var form_data = {};
	form_data['search_type'] = search_type;
	if(search_type == 1){
		var location_id = $("#bench"+dynamic_param).val();
		var case_type = $("#case_type"+dynamic_param).val();
		var case_no = $("#case_no"+dynamic_param).val();
		var case_year = $("#case_year"+dynamic_param).val();
		if(case_no == '' && case_year == ''){
			alert("please enter case number and case year");
			return false;
		}
		if(case_no == ''){
			alert("please enter case number");
			return false;
		}
		if(case_year == ''){
			alert("please enter case year");
			return false;
		}
		form_data['location_id'] = location_id;
		form_data['case_type'] = case_type;
		form_data['case_no'] = case_no;
		form_data['case_year'] = case_year;
	}else{
		var location_id = $("#bench"+dynamic_param).val();
		var filing_no = $("#filing_no"+dynamic_param).val();
		form_data['location_id'] = location_id;
		form_data['filing_no'] = filing_no;
	}
	var main_filing_no = $("#set_filing_no").val();
	$.ajax({
		type: "POST",
		url: "../ajax/connected_cases.php",
		data: {form_data:form_data,type:"get_connected_cases",dynamic_param:dynamic_param,main_filing_no:main_filing_no,con_type:type},
		beforeSend: function() {
		},
		success: function (response) {
			if(dynamic_param == ''){
			$("#view_connected_cases,#cause_title").removeClass('show');
			$("#view_connected_cases,#cause_title").addClass('hide');
			}else{
			$("#cause_title"+dynamic_param).removeClass('show');
			$("#cause_title"+dynamic_param).addClass('hide');	
			}
			var obj = JSON.parse(response);
			if(obj.status == 'error' || obj.msg !== ''){
				alert(obj.msg);
				$("#cause_title"+dynamic_param+" h4").html(obj.msg);
				$("#cause_title"+dynamic_param).removeClass('hide');
				$("#cause_title"+dynamic_param).addClass('show');
				if(dynamic_param == ''){
				$("#search_form_second").css('display','none');
				$("#cause_title_second").removeClass('show');
				$("#cause_title_second").addClass('hide');
				$("#set_filing_no,#set_con_filing_no").val('');
				}else{
					$("#set_con_filing_no").val('');
				}						
				$("#connect_button_second").removeClass('show');
				$("#connect_button_second").addClass('hide');	
				return false;
			}else{
				
				
				if(dynamic_param == ''){
					$("#search_form_second").css('display','inherit');
					$("#cause_title_second").removeClass('hide');
					$("#cause_title_second").addClass('show');	
					//alert(dynamic_param+"sdfsdjkl");
				$("#cause_title"+dynamic_param+" h4").html(obj.main_case.pet_name+' VS. '+obj.main_case.res_name);
					if(obj.type == 'con'){
						$.each( obj.connected_cases, function( key, value ) {
							var count = (key+1);
							var tr = '<tr><td>'+count+'</td><td>'+value.conn_filing_no+'</td><td>'+value.case_type_short_name+'/'+value.case_no+'('+value.city_short_name+')/'+value.case_year+'</td><td>'+value.status+'</td></tr>';
							$("#view_connected_cases #table_data #search_data_here").append(tr);
						});
					}else{
						$.each( obj.connected_cases, function( key, value ) {
							var count = (key+1);
							var disconnect_link = "<button type='button' class='btn btn-sm btn-danger' onClick=disconnect_case("+"'"+value.id+"'"+","+"'"+obj.main_case.filing_no+"'"+","+"'"+value.conn_filing_no+"'"+");>Disconnect</button>";
							var tr = "<tr id='row'"+value.id+"><td>"+count+"</td><td>"+value.conn_filing_no+"</td><td>"+value.case_type_short_name+"/"+value.case_no+"("+value.city_short_name+")/"+value.case_year+"</td><td>"+disconnect_link+"</td></tr>";
							$("#view_connected_cases #table_data #search_data_here").append(tr);
						});
					}
				
				$("#cause_title , #view_connected_cases").addClass('show');
				$("#cause_title, #view_connected_cases").removeClass('hide');
				$("#cause_title_second").addClass('hide');
				$("#cause_title_second").addClass('show');
				$("#connect_button_second").removeClass('show');
				$("#connect_button_second").addClass('hide');
				$("#set_filing_no").val(obj.main_case.filing_no);
				get_form(search_type,"_second");
				}else{
					$("#search_form_second").css('display','inherit');
					/* $("#cause_title_second").removeClass('hide');
					$("#cause_title_second").addClass('show');	
				
					$("#cause_title"+dynamic_param+" h4").html(obj.main_case.pet_name+' VS. '+obj.main_case.res_name);
					$("#cause_title"+dynamic_param).addClass('show');
					$("#cause_title"+dynamic_param).removeClass('hide'); */
					var table_obj = "<table cellspacing='0' align='center' class='table no-margin table-bordered table-striped table-hover'><thead><tr><th></th><th>SN</th><th>Filing No</th><th>Case No</th><th>Title</th></tr></thead><tbody>";
					var all_cases = obj.main_case.length;
					var filing_nos = '';
					$.each( obj.main_case, function( key, value ) {
						var count = (key+1);
						var tr = '<tr><td></td><td>'+count+'</td><td>'+value.filing_no+'</td>><td>'+value.case_type_desc+'/'+value.case_no+'/'+value.case_year+'</td><<td>'+value.pet_name+' VS '+value.res_name+'</td></tr>';
						table_obj = table_obj+tr;
						if(count == all_cases)
							filing_nos += value.filing_no;
						else
							filing_nos += value.filing_no+',';
					});
					var table_end = "</tbody></table>";
					table_obj = table_obj+table_end;
					$("#set_con_filing_no").val(filing_nos);
					$("#show_bulk").append(table_obj);
					$("#connect_button"+dynamic_param).removeClass('hide');
					$("#connect_button"+dynamic_param).addClass('show');
					
				}
				
			}
		},
		error: function (textStatus, errorThrown) {
		   alert("error");
		}

	});	
}
	
function connect_case(){
	var main_filing_no = $("#set_filing_no").val();
	var conn_filing_no = $("#set_con_filing_no").val();
	if(main_filing_no === '' || conn_filing_no === ''){
		alert("Please fill all details");
		return false;
	}
	$("#connect_case").attr('disabled','disabled');
	$.ajax({
            type: "POST",
            url: "../ajax/connected_cases.php",
            data: {main_filing_no:main_filing_no,conn_filing_no:conn_filing_no,type:"connect_case"},
			beforeSend: function() {
			},
            success: function (response) {
				var obj = JSON.parse(response);
				if(obj.status == 'error'){
					alert(obj.msg);
				}else{
					alert(obj.msg);
					get_cases('','con');
					$("#connect_case").removeAttr('disabled');
					//location.reload(true);
				}
            },
            error: function (textStatus, errorThrown) {
               alert("error");
            }

        });	
	
}

