<script>
    function delete_judge(judge_code,token){
        let text = "Are you sure want to delete judge ?";
        if (confirm(text) == true) {
            $.ajax({
                url: "judge_master_action.php", 
                method : 'POST',
                data : {token:token,edit_id:judge_code,frmAction:'delete'},
                success: function(result){
                    alert('Record deleted');
                    location.reload(true);
            }}); 
            } 
    }

    function show_hide_judge(judge_code,token,current_state){
        let text = "Are you sure want change display ?";
        if (confirm(text) == true) {
            $.ajax({
                url: "judge_master_action.php", 
                method : 'POST',
                data : {token:token,edit_id:judge_code,display:current_state,frmAction:'show_hide'},
                success: function(result){
                    alert('Record updated');
                    location.reload(true);
            }}); 
            } 
    }
</script>

