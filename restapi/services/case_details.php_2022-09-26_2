			echo json_encode($response,true);
			die;
		}
		
		/*  http_response_code(200);
		echo json_encode($data,true);
		die;  */
		
		foreach($data as $k=>$value){
			
			$child_cases = $case_obj->get_child_cases_details($db,$schema,$value['filing_no']);
			$data[$k]['connected_cases_ias'] = $child_cases;
			$orders_or_judgements = $case_obj->get_orders_judgements($db,$schema,$page,$value['filing_no']);
			$data[$k]['orders_judgements'] = $orders_or_judgements;
			foreach($orders_or_judgements as $key=>$order){
				$coram = $case_obj->get_coram($db, $schema, $order['date_of_judgement_order'],$order['bench_no']);
				$data[$k]['orders_judgements'][$key]['coram'] = $coram;
			}
		}
		$response['data'] = $data;
		http_response_code(200);
		echo json_encode($response,true);
		die;
	}else{
		$response = array('status'=>500,'msg'=>'something went wrong');
		http_response_code(500);
		echo json_encode($response,true);
		die;
	}
