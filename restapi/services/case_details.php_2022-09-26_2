              $data_search =   "od.order_html like '%$text_name%'";
            }
			$data = $case_obj->get_orders_judgements_freetext_wise($db,$schema,$page,$data_search);
			
		}else{
			$response = array('status'=>0,'msg'=>'Something went wrong');
