		}elseif($search_by_option == 'party_wise'){
			$party_type = htmlspecialchars(htmlentities($_POST['party_type']));
			$party_name = htmlspecialchars(htmlentities(strtolower($_POST['party_name'])));
			$case_year =  htmlspecialchars(htmlentities($_POST['case_year']));
			if ($party_type == '1') {
				$cases = $case_obj->get_cases_main_party_wise($db,$schema,$party_type,$party_name,$case_year);
            } else if ($party_type == '2') {
				
                $whwre = '';
                if ($case_year != 'All') {
                    $whwre = " and filing_no like '%$case_year' ";
                }
				$query = "SELECT filing_no FROM public.e_cases_party where (filing_no != 'NA' OR filing_no is not null) and  lower(name) like '%$party_name%' $whwre ";
				$st_party = $db->prepare($query);
                $st_party->execute();
                $filing_no_data = $st_party->fetchAll();
                $fiing_nos = '';
                if (!empty($filing_no_data) && is_array($filing_no_data)) {
                    foreach ($filing_no_data as $val) {
                        $filiddd = $val["filing_no"];
                        $fiing_nos .= "'$filiddd'" . ',';
                    }
                }
                $fiing_nos = rtrim($fiing_nos, ',');

                $filing_noss = " in( $fiing_nos)"; 
                if($fiing_nos == '') { 
                    $filing_noss = " = 'sssssss' ";
                }

				$cases = $case_obj->get_cases_additional_party_wise($db,$schema,$filing_noss);
            }
		}elseif($search_by_option == 'advocate_wise'){
			$advocate_name = htmlspecialchars(htmlentities(strtolower($_POST['advocate_name'])));;
			$case_year = htmlspecialchars(htmlentities($_POST['case_year']));
			$whwre = '';
            if ($case_year != 'All') {
                $whwre = " and filing_no like '%$case_year' ";
            }
			$query = "SELECT (a.rep_code),a.filing_no FROM
            public.e_more_representative as a
                        join e_master_advocate as b ON a.rep_code = b.id
                         where (a.filing_no != 'NA' AND a.filing_no is not null) and
                         a.display = true and (b.rep_name != 'NA' OR b.rep_name is not null) and lower(b.rep_name) like '%$advocate_name%'  $whwre ";
		   $st_party = $db->prepare($query);

            $st_party->execute();
            $filing_no_data = $st_party->fetchAll();
            $fiing_nos = '';
            if (!empty($filing_no_data) && is_array($filing_no_data)) {
                foreach ($filing_no_data as $val) {
                    $filiddd = $val["filing_no"];
                    $fiing_nos .= "'$filiddd'" . ',';
                }
            }
            $fiing_nos = rtrim($fiing_nos, ',');

            $filing_noss = "in( $fiing_nos)"; 
            if($fiing_nos == '') { 
                $filing_noss = " = 'sssssss' ";
            }
			$cases = $case_obj->get_cases_advocated_wise($db,$schema,$filing_noss);
		}else{
			$response = array('status'=>0,'msg'=>'Something went wrong');
			http_response_code(500);
			echo json_encode($response,true);
			die;
		}
		$response['data'] = $cases;
		http_response_code(200);
		echo json_encode($response,true);
		die;
	}

