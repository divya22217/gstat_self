	public function get_orders_judgements_judge_wise($db,$schema,$page,$case_type,$judge_code,$category,$from_date,$to_date,$search_by_option){
		$case_type_where = '';
		if($case_type != 'All') {
			$case_type_where = " and cd.case_type = ? ";
		}
		$category_where = '';
		if($category != 'All') {
			$category_where = " and cd.status = ? ";
		}
		if($page == 'orders'){
			$order_query = " and (od.order_type = ? or od.order_type = ?)";
			$order_type = 'D';
			$order_type_2 = 'DC';
		}else if($page == 'judgements'){
			$order_query = " and (od.order_type = ? or od.order_type = ?)";
			$order_type = 'J';
			$order_type_2 = 'JC';
		}else if($page == 'judgements_orders'){
			$order_query = "";
		}else{
			$order_query = " and (od.order_type = ? or od.order_type = ?)";
			$order_type = '';
			$order_type_2 = '';
		}
		$inner_query = '';
		if($search_by_option == 'judges_member_wise'){
			$inner_query = " and (string_to_array(od.judge_codes, ',') && Array['$judge_code'])";
		}
		$query = "select distinct(temp1.filing_no) as filing_no,temp1.case_no,temp1.case_type,temp1.case_year,temp1.status,
		(coalesce(ecp1.name,'')|| ' VS ' ||coalesce(ecp2.name,'')) as case_title,
		temp1.main_case_ia_no,temp1.bench
		from (select distinct(od.filing_no) as filing_no,cd.case_no,cd.case_year,cd.status,
		cd.location_code,ct.short_name as case_type,mlc.city_name as bench,
		case when (length(cd.main_case_ia_no) = ?) then cd.main_case_ia_no else cd.filing_no end as party_filing_no,cd.main_case_ia_no
		from $schema.order_daily as od 
		left join $schema.case_detail as cd on cd.filing_no = od.filing_no
		left join case_type as ct on ct.id = cd.case_type
		left join mater_location_city as mlc on mlc.city_id = cd.location_code
		where (od.order_date between ? and ?) 
		$inner_query $case_type_where  and cd.status != ? $category_where
		$order_query) as temp1
		left join e_cases_party as ecp1 on ecp1.filing_no = temp1.party_filing_no and ecp1.party_flag = ? and ecp1.party_serial_no = ?
		left join e_cases_party as ecp2 on ecp2.filing_no = temp1.party_filing_no and ecp2.party_flag = ? and ecp2.party_serial_no = ?";
		

		$stmt = $this->conn->prepare($query);
		$stmt->bindParam(1, $this->filing_no_length, PDO::PARAM_STR);
		$stmt->bindParam(2, $from_date, PDO::PARAM_STR);
		$stmt->bindParam(3, $to_date, PDO::PARAM_STR);
		$srn = 4;
		if($case_type != 'All') {
			$stmt->bindParam($srn, $case_type, PDO::PARAM_STR);
			$srn++;
		} 
		$stmt->bindParam($srn, $this->wrong_status, PDO::PARAM_STR);  $srn++;
		if($category != 'All') {
			$stmt->bindParam($srn, $category, PDO::PARAM_STR);
			$srn++;
		}
		if($page != 'judgements_orders'){		
			$stmt->bindParam($srn, $order_type, PDO::PARAM_STR);  $srn++;
			$stmt->bindParam($srn, $order_type_2, PDO::PARAM_STR);  $srn++;
		}
		$stmt->bindParam($srn, $this->pet_party_flag, PDO::PARAM_STR);  $srn++;
		$stmt->bindParam($srn, $this->party_serial_no, PDO::PARAM_STR); $srn++;
		$stmt->bindParam($srn, $this->res_party_flag, PDO::PARAM_STR);  $srn++;
		$stmt->bindParam($srn, $this->party_serial_no, PDO::PARAM_STR);
		$stmt->execute();
		$case_info = $stmt->fetchAll();
		return $case_info;
	}



