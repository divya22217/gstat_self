		left join e_cases_party as ecp1 on ecp1.filing_no = temp1.party_filing_no and ecp1.party_flag = 'P' and ecp1.party_serial_no = 1
		left join e_cases_party as ecp2 on ecp2.filing_no = temp1.party_filing_no and ecp2.party_flag = 'R' and ecp2.party_serial_no = 1

		union all
																														 
		select temp1.filing_no,temp1.case_no,temp1.case_type,temp1.case_year,(coalesce(ecp1.name,'')|| ' VS ' ||coalesce(ecp2.name,'')) as case_title,
		temp1.date_of_registration, temp1.status,temp1.order_date,temp1.location_code,temp1.order_type from  (select 
		od.filing_no,cast(a.case_no as int) as case_no ,a.case_year,b.short_name as case_type,od.order_date,a.location_code,od.order_type,
