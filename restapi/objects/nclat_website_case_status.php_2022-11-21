			$query_search = "and od.order_type in ('J','JC')";
		}else{
			$query_search = '';
		}
		$query = "select final_data.* from (select temp1.filing_no,temp1.case_no,temp1.case_type,temp1.case_year,(coalesce(ecp1.name,'')|| ' VS ' ||coalesce(ecp2.name,'')) as case_title,
		temp1.date_of_registration, temp1.status,temp1.order_date,temp1.location_code,temp1.order_type from  (select 
		od.filing_no,cast(a.case_no as int) as case_no ,a.case_year,b.short_name as case_type,od.order_date,a.location_code,od.order_type,
		case when (length(a.main_case_ia_no) = '16') then a.main_case_ia_no else a.filing_no end as party_filing_no,
		case when (a.backlog = 0) then a.regis_date else null end as date_of_registration,a.status,a.main_case_ia_no
