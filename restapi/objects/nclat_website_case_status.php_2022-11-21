	public function get_coram($db, $schema, $listing_date,$bench_no){
		$coram_name_chairperson = '';
		$query = "select hon_text,md.desg_name,jm.judge_name,bj.judge_code,jm.judge_desg_code  
				from $schema.bench_judge as bj,$schema.master_judge as jm
				Join $schema.master_desg md ON jm.judge_desg_code = md.desg_code
				where bj.from_list_date =? and bj.bench_no=? and jm.judge_code=bj.judge_code order by jm.judge_desg_code asc"; 
		$stmt = $this->conn->prepare($query);
		$stmt->bindParam(1, $listing_date, PDO::PARAM_STR);
		$stmt->bindParam(2, $bench_no, PDO::PARAM_STR);
		$stmt->execute();
		$judge_data = $stmt->fetchAll();
		$coram_name = '';
		foreach ($judge_data as $value) {
			if($value['judge_desg_code'] == '1' || $value['judge_desg_code'] == '6'  || $value['judge_desg_code'] == '7' || $value['judge_desg_code'] == '8' ){
				$coram_name_chairperson .= $value['hon_text'] . ' ' . $value['judge_name'] . ' (' . $value['desg_name'] . ')';
				$coram_name_chairperson .= " , ";
			}else{
			$coram_name .= $value['hon_text'] . ' ' . $value['judge_name'] . ' (' . $value['desg_name'] . ')';
			$coram_name .= " , ";
			}
		}
		$final_coram = $coram_name_chairperson.$coram_name;
		return $final_coram;
	}
	
