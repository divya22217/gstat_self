		$order_pdf  = $parser->parseFile($path);
		$order_text = $order_pdf->getText();
		}
		catch(Exception $e){
			$order_text = 'NA';
		}finally{
			if($order_text == ''){
				$order_text = 'NA';
			}
		}
		return $order_text;
	}
	
