
function fn_case_dfr_type(value) {
    $("#case_dfr_div_id").empty();
    $('.load_container').show();

    $("#listing_case_detaisl").hide();
    $("#view_case_type_details").empty(data);
    var data = {};
    data['action'] = 'select_case_status';
    data['search_by'] = value;
	data['schema_name'] = $("#location").val();
    $.ajax({
        type: "POST",
        url: "ajax/ajax.php",
        data: data,
        dataType: "html",
